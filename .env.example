# ============================================================================
# Antigravity Remote Assistant (.env.example)
# 运行 `python -m qq_agy_bridge.setup_wizard` 可自动生成 .env 与随机强密钥
# ============================================================================

# 通道开关：
# - WEB_PWA_ENABLED=true  -> 开启专属手机端毛玻璃 Web App（扫码即用，零第三方依赖）
# - ONEBOT_ENABLED=auto   -> 填了 ALLOWED_QQ_USERS 自动同时开启 QQ 私聊；留空则纯运行手机端 Web App
WEB_PWA_ENABLED=true
WEB_PWA_HOST=0.0.0.0
WEB_PWA_PORT=8765
WEB_ACCESS_TOKEN=
CLOUDFLARE_TUNNEL_ENABLED=true

ONEBOT_ENABLED=auto
ONEBOT_MODE=forward_ws
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_REVERSE_HOST=127.0.0.1
ONEBOT_REVERSE_PORT=8080
ONEBOT_REVERSE_PATH=/onebot/v11/ws
ONEBOT_ACCESS_TOKEN=

# QQ 私聊安全白名单（仅启用 QQ 通道时必填，多个 QQ 号用英文逗号分隔；严禁留空开启 QQ 通道）
ALLOWED_QQ_USERS=
# 机器人登录的 QQ 号（仅桌面启动器自动拉起 NapCatNode 时可选填写）
BOT_QQ=
# 可选：自定义 NapCatNode 目录路径
NAPCAT_DIR=

# Antigravity CLI 配置（留空自动查找本机已登录的 agy 可执行文件）
AGY_EXECUTABLE=agy
AGY_WORKSPACE=
AGY_MODEL=claude-sonnet-5-5-medium
AGY_FALLBACK_MODELS=claude-sonnet-5-5-medium,claude-sonnet-5-5-low,gemini-4-neon-medium,gemini-4-carbon-medium,gemini-3.8-flash-high,gpt-oss-120b-medium
QUOTA_COOLDOWN_MINUTES=60
AGY_EFFORT=
AGY_DANGEROUSLY_SKIP_PERMISSIONS=true
AGY_TIMEOUT_SECONDS=300
AGY_PREWARM=true
AGY_PREWARM_USERS=

# 体验与自动维护
MESSAGE_DEBOUNCE_SECONDS=1.2
PROGRESS_NOTICE_DELAY_SECONDS=22
CACHE_CLEAN_INTERVAL_HOURS=6
AGY_SYSTEM_PROMPT_FILE=prompts/qq_persona.md
USER_MEMORY_FILE=memory/user_profile.md
CLEAN_QQ_FORMATTING=true
MAX_MESSAGE_LENGTH=1800
LOG_LEVEL=INFO
